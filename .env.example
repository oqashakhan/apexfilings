# ==================================================
# Apex Filings Environment Configuration
# ==================================================

# AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Server-side only. Set in Netlify environment variables and local .env; never prefix with VITE_.
GOOGLE_TRANSLATE_API_KEY=""

# Public, owner-approved Privacy Policy URL. The consultation form stays closed until set.
VITE_PRIVACY_POLICY_URL=""

# Database Configuration (PostgreSQL / Prisma)
# e.g., postgresql://apex_user:password@localhost:5432/apex_filings
DATABASE_URL="postgresql://user:password@localhost:5432/apex_filings?schema=public"

# Authentication (Auth.js / NextAuth)
AUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="https://apexfiling.com"

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email & Notification Services (SMTP / Resend)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="support@apexfiling.com"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="Apex Filings <support@apexfiling.com>"

# Cloudflare & Storage
CLOUDFLARE_ZONE_ID="your_zone_id"
CLOUDFLARE_API_TOKEN="your_token"
