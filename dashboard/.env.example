# The same-origin Next.js service serves both the dashboard and /api/v1.
DATABASE_URL="postgresql://apex:replace-me@127.0.0.1:5434/apex_dashboard?schema=public"
APP_ORIGIN="http://localhost:3001"
PUBLIC_SITE_ORIGIN="http://localhost:3000"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ONBOARDING_HANDOFF_SECRET="replace-with-a-random-32-byte-base64url-secret"
# Absolute path on a private, persistent volume. Never place this under public/.
PRIVATE_DOCUMENT_DIR="./private-documents"
# Optional. Until a verified email provider is configured, reset requests return a
# generic response and no customer email is sent.
RESET_DELIVERY="disabled"
