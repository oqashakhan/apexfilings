# The same-origin Next.js service serves both the dashboard and /api/v1.
DATABASE_URL="postgresql://apex:replace-me@127.0.0.1:5434/apex_dashboard?schema=public"
APP_ORIGIN="http://localhost:3001"
PUBLIC_SITE_ORIGIN="http://localhost:3000"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ONBOARDING_HANDOFF_SECRET="replace-with-a-random-32-byte-base64url-secret"
# Separate 32-byte base64url secret for keyed OTP hashes and encrypted queued OTP emails.
# Generate with the same command above; keep this stable across releases.
EMAIL_OTP_SECRET=""
# Absolute path on a private, persistent volume. Never place this under public/.
PRIVATE_DOCUMENT_DIR="./private-documents"
# Optional local-only reset-link file output for development. Production uses Resend.
RESET_DELIVERY="disabled"

# Resend transactional email. Verify apexfilings.com in Resend before using info@apexfilings.com.
RESEND_API_KEY=""
EMAIL_FROM=""
ADMIN_NOTIFICATION_EMAIL=""
# A long random value, used only by the Coolify scheduled email worker request.
EMAIL_JOB_SECRET=""
RESEND_WEBHOOK_SECRET=""

# Google Cloud OAuth web client. Authorized redirect URI:
# https://app.apexfilings.com/api/v1/auth/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
