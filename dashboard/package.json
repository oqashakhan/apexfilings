{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "node scripts/check-registration-readiness.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "pricing:diagnose": "tsx scripts/diagnose-state-pricing.ts",
    "clients:backfill-references": "tsx scripts/backfill-client-references.ts",
    "invoices:backfill": "node --conditions=react-server --import tsx scripts/backfill-invoices.ts",
    "test:invoices": "node --import tsx --test -r ./tests/test-env.cjs tests/invoices.test.cjs",
    "test:migration-recovery": "node --test -r ./tests/test-env.cjs tests/invoice-migration-recovery.test.cjs",
    "test:client-references": "node --import tsx --test -r ./tests/test-env.cjs tests/client-references.test.cjs",
    "email:check": "node scripts/check-registration-readiness.mjs",
    "owner:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "test:integration": "node --test -r ./tests/test-env.cjs tests/integration.test.cjs",
    "test:stripe": "node --test -r ./tests/test-env.cjs tests/stripe-integration.test.cjs",
    "test:pricing": "node --import tsx --test tests/pricing.test.ts tests/payment-summary.test.tsx tests/wizard-redesign.test.tsx tests/state-fee-approval.test.tsx",
    "test:pricing:integration": "node --test -r ./tests/test-env.cjs tests/pricing-integration.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "lucide-react": "^0.546.0",
    "next": "16.4.3",
    "openid-client": "^6.8.8",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "svix": "^1.99.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  }
}
